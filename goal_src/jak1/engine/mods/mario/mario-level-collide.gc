(defun update-mario-loaded-surfaces ()
  (dotimes (i 2)
    (let ((lvl-name (-> *load-state* want i name)))
      (cond
        ((name= lvl-name "training") (if (= i 0) (set! arg1-mario-lvl 1.0) (set! arg2-mario-lvl 1.0)))
        ((name= lvl-name "village1") (if (= i 0) (set! arg1-mario-lvl 2.0) (set! arg2-mario-lvl 2.0)))
        ((name= lvl-name "beach") (if (= i 0) (set! arg1-mario-lvl 3.0) (set! arg2-mario-lvl 3.0)))
        ((name= lvl-name "jungle") (if (= i 0) (set! arg1-mario-lvl 4.0) (set! arg2-mario-lvl 4.0)))
        ((name= lvl-name "jungleb") (if (= i 0) (set! arg1-mario-lvl 5.0) (set! arg2-mario-lvl 5.0)))
        ((name= lvl-name "misty") (if (= i 0) (set! arg1-mario-lvl 6.0) (set! arg2-mario-lvl 6.0)))
        ((name= lvl-name "firecanyon") (if (= i 0) (set! arg1-mario-lvl 7.0) (set! arg2-mario-lvl 7.0)))
        ((name= lvl-name "village2") (if (= i 0) (set! arg1-mario-lvl 8.0) (set! arg2-mario-lvl 8.0)))
        ((name= lvl-name "sunken") (if (= i 0) (set! arg1-mario-lvl 9.0) (set! arg2-mario-lvl 9.0)))
        ((name= lvl-name "sunkenb") (if (= i 0) (set! arg1-mario-lvl 10.0) (set! arg2-mario-lvl 10.0)))
        ((name= lvl-name "swamp") (if (= i 0) (set! arg1-mario-lvl 11.0) (set! arg2-mario-lvl 11.0)))
        ((name= lvl-name "rolling") (if (= i 0) (set! arg1-mario-lvl 12.0) (set! arg2-mario-lvl 12.0)))
        ((name= lvl-name "ogre") (if (= i 0) (set! arg1-mario-lvl 13.0) (set! arg2-mario-lvl 13.0)))
        ((name= lvl-name "village3") (if (= i 0) (set! arg1-mario-lvl 14.0) (set! arg2-mario-lvl 14.0)))
        ((name= lvl-name "snow") (if (= i 0) (set! arg1-mario-lvl 15.0) (set! arg2-mario-lvl 15.0)))
        ((name= lvl-name "maincave") (if (= i 0) (set! arg1-mario-lvl 16.0) (set! arg2-mario-lvl 16.0)))
        ((name= lvl-name "darkcave") (if (= i 0) (set! arg1-mario-lvl 17.0) (set! arg2-mario-lvl 17.0)))
        ((name= lvl-name "robocave") (if (= i 0) (set! arg1-mario-lvl 18.0) (set! arg2-mario-lvl 18.0)))
        ((name= lvl-name "lavatube") (if (= i 0) (set! arg1-mario-lvl 19.0) (set! arg2-mario-lvl 19.0)))
        ((name= lvl-name "citadel") (if (= i 0) (set! arg1-mario-lvl 20.0) (set! arg2-mario-lvl 20.0)))
        ((name= lvl-name "finalboss") (if (= i 0) (set! arg1-mario-lvl 21.0) (set! arg2-mario-lvl 21.0))))))
  (when (or (!= arg1-mario-lvl last-arg1-mario-lvl) (!= arg2-mario-lvl last-arg2-mario-lvl))
    ;; Missing for some reason
    (pc-update-mario-level-collide arg1-mario-lvl arg2-mario-lvl)
    (set! last-arg1-mario-lvl arg1-mario-lvl)
    (set! last-arg2-mario-lvl arg2-mario-lvl)))

(defun mario-level-collide-main-func ()
  (update-mario-loaded-surfaces)
  (none))
