(defun-extern get-mario-state symbol)

(define *render-mario?* #t)

 ;;50.0 is the amount we needed to adjust the collide mesh from blender
(define *mario-scale-mult* (/ (meters 1.0) 50.0))

;;used in the level collision system
(define arg1-mario-lvl 0.0)

(define arg2-mario-lvl 0.0)

(define last-arg1-mario-lvl -1.0)

(define last-arg2-mario-lvl -1.0)
